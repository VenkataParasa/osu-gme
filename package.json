{
  "name": "gme-central",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src/**/*.ts src/**/*.tsx src/*.tsx src/styles.css tests/*.ts tests/*.mjs vite.config.ts",
    "test:browser": "node tests/browser-check.mjs",
    "test:extensions": "node tests/extensions-check.mjs"
    ,"test:health": "node tests/program-health-check.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
